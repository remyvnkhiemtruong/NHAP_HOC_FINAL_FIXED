{
  "name": "vvk-admission-system",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "clean:next-types": "node scripts/clean-next-types.mjs",
    "prebuild": "npm run clean:next-types",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:unit": "jest --runInBand",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:uat": "tsx scripts/run-official-uat-tests.ts",
    "test:e2e": "tsx scripts/run-e2e-tests.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "backfill:search-indexes": "tsx scripts/backfill-search-indexes.ts",
    "worker": "tsx src/services/queue/worker.ts",
    "setup:env": "node scripts/setup-env.mjs",
    "verify:config": "node scripts/verify-compose-config.mjs",
    "verify:prisma": "prisma validate",
    "verify:audit": "npm audit --audit-level=high",
    "verify": "npm run verify:config && npm run verify:prisma && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e && npm run build && npm run verify:audit",
    "postinstall": "node scripts/patch-brace-expansion.mjs && prisma generate",
    "pretypecheck": "npm run clean:next-types",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "find-my-way": "9.7.0",
    "postcss": "8.5.22",
    "sharp": "$sharp",
    "uuid": "11.1.1",
    "valibot": "1.4.2"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@types/pdfkit": "^0.17.6",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.10",
    "busboy": "^1.6.0",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "exceljs": "4.1.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.25.0",
    "next": "^16.2.12",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "react-image-crop": "^11.1.2",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prisma": "7.9.0",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
