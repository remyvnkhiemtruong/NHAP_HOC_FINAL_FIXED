# Năm tuyển sinh dùng khi kiểm tra ngày sinh và hiển thị nghiệp vụ.
ADMISSION_YEAR="2026"

# Thông số dùng với docker-compose.yml ở môi trường phát triển.
POSTGRES_USER="vvk_app"
POSTGRES_PASSWORD="CHANGE_ME_DATABASE_PASSWORD"
POSTGRES_DB="vvk_2026_2027"

# PostgreSQL. Dùng tài khoản riêng, quyền tối thiểu và TLS ở production.
DATABASE_URL="postgresql://vvk_app:CHANGE_ME_DATABASE_PASSWORD@localhost:5433/vvk_2026_2027?schema=public"

# BullMQ / Redis. Dùng endpoint có xác thực/TLS ở production.
REDIS_URL="redis://localhost:6380"

# Khóa ký phiên: tối thiểu 32 byte ngẫu nhiên.
JWT_SECRET="CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES"

# Khóa mã hóa AES-256: đúng 64 ký tự hex (32 byte), tạo riêng cho từng môi trường.
ENCRYPTION_KEY="CHANGE_ME_TO_EXACTLY_64_HEXADECIMAL_CHARACTERS_0000000000000000"

# Danh sách CCCD ngoại lệ đã được phê duyệt, phân tách bằng dấu phẩy; để trống nếu không dùng.
CCCD_EXCEPTION_LIST=""

# ADMIN ban đầu, chỉ dùng bởi `npm run seed:admin`.
ADMIN_INITIAL_USERNAME="CHANGE_ME"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_WITH_AT_LEAST_16_CHARACTERS"

# Private storage dùng chung giữa tiến trình web và worker.
STORAGE_ROOT="./storage"
